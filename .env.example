# 이름과 예시 값이에요. 실제 값은 .env.local(커밋 안 함)이나 Vercel 환경 변수에 넣어요.

# 사례 화면이 부르는 API 주소 (기본: JSONPlaceholder)
NEXT_PUBLIC_API_BASE_URL=https://jsonplaceholder.typicode.com
# true면 MSW로 응답해요(개발용)
NEXT_PUBLIC_API_MOCKING=false
# 직접 도메인을 붙였을 때만. 없으면 Vercel이 넣어 주는 NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL을 써요
# NEXT_PUBLIC_SITE_URL=https://sonic-ui.example.com
